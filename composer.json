{
  "name": "estratos/sie-banxico",
  "type": "symfony-bundle",
  "description": "Banxico SIE REST API Client for Symfony Framework",
  "keywords": ["php", "symfony", "banxico sie", "exchange rate"],
  "license": "MIT",
  "authors": [
    {
      "name": "Julio Rodriguez",
      "email": "julio.stratos@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": { "Estratos\\SieBanxico\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": {
      "Estratos\\SieBanxico\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.1",
    "symfony/config": "^6.4 || ^7.0 || ^8.0",
    "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
    "xint0/banxico-php": "^2.0"
  },
  "require-dev": {
    "php-http/guzzle7-adapter": "^1.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^10.5 || ^11.0",
    "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
  },
  "suggest": {
    "php-http/discovery": "Allows automatic discovery of the PSR-18 HTTP client used by xint0/banxico-php",
    "php-http/guzzle7-adapter": "Guzzle 7 PSR-18 client used by default when the SIE client builds its own HTTP client"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "3.0-dev"
    }
  }
}
